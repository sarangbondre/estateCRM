{
  "name": "11estates-crm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "lint:all": "eslint . && depcruise services libs --config .dependency-cruiser.cjs",
    "layers": "depcruise services libs --config .dependency-cruiser.cjs",
    "secrets": "gitleaks detect --no-banner --redact",
    "format": "prettier --check .",
    "contracts:lint": "redocly lint contracts/openapi/*.yaml && node tools/contracts/validate-asyncapi.mjs && node tools/contracts/check-event-fixtures.mjs",
    "contracts:gen": "python3 tools/gen_events.py && python3 tools/gen_tasks.py && node tools/gen_gate_tables.mjs && node tools/contracts/gen-types.mjs && node tools/contracts/gen-bundles.mjs && node tools/contracts/gen-event-fixtures.mjs && node tools/gen-db-bootstrap.mjs && node tools/gen-schedules.mjs",
    "contracts:check": "pnpm contracts:gen && git diff --exit-code -- contracts docs tools infra",
    "mock": "node tools/contracts/mock.mjs",
    "mock:event": "node tools/contracts/publish-event.mjs",
    "mock:smoke": "node tools/contracts/mock-smoke.mjs",
    "db:start": "supabase --workdir infra start && node infra/scripts/local-roles.mjs",
    "db:stop": "supabase --workdir infra stop",
    "db:reset": "supabase --workdir infra db reset && node infra/scripts/local-roles.mjs",
    "db:env": "node infra/scripts/local-roles.mjs --env",
    "db:verify": "node infra/scripts/verify-platform.mjs",
    "dev": "pnpm db:start && turbo run dev",
    "db:schedules": "node infra/scripts/local-roles.mjs --schedules"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.3",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.54.3",
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "^24.19.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.2",
    "json-schema-faker": "0.6.3",
    "openapi-typescript": "7.13.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.2"
  }
}
