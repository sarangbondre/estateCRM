{
  "name": "11estates-crm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "lint:all": "eslint . && depcruise services libs --config .dependency-cruiser.cjs",
    "layers": "depcruise services libs --config .dependency-cruiser.cjs",
    "secrets": "gitleaks detect --no-banner --redact",
    "format": "prettier --check .",
    "contracts:lint": "redocly lint contracts/openapi/*.yaml && node tools/contracts/validate-asyncapi.mjs",
    "contracts:gen": "python3 tools/gen_events.py && python3 tools/gen_tasks.py && node tools/gen_gate_tables.mjs && node tools/contracts/gen-types.mjs",
    "contracts:check": "pnpm contracts:gen && git diff --exit-code -- contracts docs tools"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.3",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.54.3",
    "@types/node": "^24.19.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "js-yaml": "^5.4.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
