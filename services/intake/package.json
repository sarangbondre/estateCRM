{
  "name": "@11e/intake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "migrate": "node --env-file-if-exists=../../.env.local ../../libs/db/dist/cli/migrate.js --schema intake --dir migrations",
    "migrate:check": "node ../../libs/db/dist/cli/migrate.js --check --dir migrations"
  },
  "dependencies": {
    "@11e/auth": "workspace:*",
    "@11e/contracts": "workspace:*",
    "@11e/db": "workspace:*",
    "@11e/http": "workspace:*",
    "@11e/observability": "workspace:*",
    "@11e/outbox": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "~4.13.9",
    "kysely": "~0.29.6",
    "uuidv7": "~1.2.1"
  },
  "devDependencies": {
    "@11e/testing": "workspace:*",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "~6.2.12",
    "pg": "~8.23.0"
  }
}
