{
  "name": "@11e/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wire-contract types generated from OpenAPI/AsyncAPI (types only, no logic, no domain models).",
  "exports": {
    "./event-topology.json": "./generated/event-topology.json",
    "./openapi/web.json": "./generated/openapi/web.json",
    "./openapi/intake.json": "./generated/openapi/intake.json",
    "./openapi/records.json": "./generated/openapi/records.json",
    "./openapi/journeys.json": "./generated/openapi/journeys.json",
    "./openapi/crm-engine.json": "./generated/openapi/crm-engine.json",
    "./openapi/listings.json": "./generated/openapi/listings.json",
    "./openapi/insight.json": "./generated/openapi/insight.json",
    "./*": "./generated/ts/*.ts"
  },
  "scripts": {
    "build": "echo generated",
    "test": "echo none",
    "lint": "echo none",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
