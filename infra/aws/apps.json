    "port": 3000,
    "cpu": 512,
    "memory": 1024,
    "secrets": {
      "DATABASE_URL": "WEB_DATABASE_URL",
      "CRON_SECRET": "WEB_CRON_SECRET",
      "KEK": "WEB_KEK",
      "SUPABASE_ANON_KEY": "SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY": "SUPABASE_SERVICE_ROLE_KEY"
    },
