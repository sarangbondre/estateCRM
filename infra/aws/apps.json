      "SVC_RECORDS_URL": "http://records:3002",
      "SVC_JOURNEYS_URL": "http://journeys:3003",
      "SVC_CRM_ENGINE_URL": "http://crm-engine:3004",
      "SVC_LISTINGS_URL": "http://listings:3005",
      "SVC_INSIGHT_URL": "http://insight:3006"
    }
  },
